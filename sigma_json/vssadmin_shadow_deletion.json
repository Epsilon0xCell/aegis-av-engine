{
  "title": "Shadow Copy Deletion via Vssadmin (sigma-subset)",
  "id": "98432000-0000-4000-8000-000000000101",
  "level": "high",
  "tags": [
    "attack.impact",
    "attack.T1490"
  ],
  "logsource": {
    "product": "windows",
    "category": "process_creation"
  },
  "detection": {
    "selection": {
      "Image|endswith": "\\vssadmin.exe",
      "CommandLine|contains": "delete shadows"
    },
    "filter_legit": {
      "CommandLine|contains": "list shadows"
    },
    "condition": "selection and not filter_legit"
  }
}